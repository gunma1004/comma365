import { useState, useEffect } from 'react';

interface Shop {
  id: number;
  name: string;
  phone: string;
  tag: string;
  desc?: string;
}

const INITIAL_SHOPS: Shop[] = [
  { 
    id: 1, 
    name: '한국미인테라피', 
    phone: '0507-1280-3303', 
    tag: '스웨디시 · 로미로미', 
    desc: '전문 테라피스트의 1:1 맞춤형 힐링 바디케어' 
  },
  { 
    id: 2, 
    name: '미인클럽테라피', 
    phone: '0507-1280-3193', 
    tag: '감성 스웨디시 · 아로마', 
    desc: '지친 일상에 활력을 불어넣는 프라이빗 감성 테라피' 
  },
  { 
    id: 3, 
    name: '오늘밤테라피', 
    phone: '0507-1280-3223', 
    tag: '24시 스웨디시 · 릴렉싱', 
    desc: '24시간 언제든 편안한 나만의 공간으로 신속 방문' 
  },
  { 
    id: 4, 
    name: '한국골든테라피', 
    phone: '0507-1280-3361', 
