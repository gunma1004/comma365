    name: '퀸즈홈테라피', 
    phone: '0507-1280-3334', 
    tag: '프리미엄 방문 홈케어', 
    desc: '철저한 위생 관리와 품격 있는 1:1 맞춤 힐링 서비스' 
  },
];

export default function FeaturedShops({ regionName }: { regionName?: string }) {
  const [shops, setShops] = useState<Shop[]>(INITIAL_SHOPS);

  useEffect(() => {
    // 새로고침 시 무작위 순서 셔플 (Fisher-Yates)
    const shuffled = [...INITIAL_SHOPS];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    setShops(shuffled);
  }, []);

  return (
    <div className="shop-grid">
      {shops.map((shop, index) => {
        // 지역명이 넘어올 경우: [지역] 출장 홈케어 마사지 제휴 형태 표기
        const displayTitle = regionName
          ? `${regionName} 출장 홈케어 · ${shop.name}`
          : shop.name;

        return (
          <div key={shop.id} className="shop-card">
            <div className="shop-badge">추천 {index + 1}위</div>
            <div className="shop-info">
              <h3>{displayTitle}</h3>
              <span className="shop-tag">{shop.tag}</span>
              {shop.desc && <p>{shop.desc}</p>}
            </div>
            <a href={`tel:${shop.phone.replace(/-/g, '')}`} className="shop-call-btn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style={{ marginRight: '6px' }}>
                <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.24 1.02l-2.21 2.2z"/>
              </svg>
              {shop.phone} 바로연결
            </a>
          </div>
        );
      })}
    </div>
  );
}